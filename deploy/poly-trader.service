[Unit]
Description=MEXC Polymarket Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mexc
Group=mexc
WorkingDirectory=/opt/mexc-signal-engine
EnvironmentFile=/opt/mexc-signal-engine/.env
ExecStart=/opt/mexc-signal-engine/.venv/bin/python polymarket_trader.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mexc-poly-trader

[Install]
WantedBy=multi-user.target
