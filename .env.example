# MEXC exchange credentials — from https://www.mexc.com/user/openapi
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET=your_mexc_secret_here

# Anthropic API key — from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Telegram bot for signal alerts — create via @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your chat ID by messaging @userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Separate Telegram bot for copy trader alerts — create a second bot via @BotFather
# Can point at the same chat ID or a different one
COPY_TELEGRAM_BOT_TOKEN=your_copy_bot_token_here
COPY_TELEGRAM_CHAT_ID=your_copy_chat_id_here

# Dashboard auth token — required when dashboard.host != 127.0.0.1 (remote access)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_TOKEN=
